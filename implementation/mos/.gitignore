# Secrets
.env
.env.*
!.env.example

# System
.DS_Store

# Dependencies
node_modules/

# Local Claude Code config (never committed)
CLAUDE.local.md

# Bridge to .claude/skills/ set up by the first setup for some agents:
# a link is never committed (git breaks it on a Windows checkout)
/skills
# Codex 0.163 and later read .agents/skills (a link to ../.claude/skills, laid by
# install.sh or upgrade.sh 0.16): the same rule
/.agents/skills

# Obsidian
.obsidian/workspace*
carte-*.html

# The guardrail's refusal trace (guard.sh): local, append-only, never committed
.claude/guard-refusals.log

# The admin GO grants (admin-go.sh): one file per session, local, never committed
.claude/hooks/grants/

# Who is at the screen on this machine (whoami.sh, 0.14): one line, the handle
# from PEOPLE.md; each machine has its own, never committed
.claude/operator
